{
    "name": "dontdrinkandroot/crud-admin-bundle",
    "type": "symfony-bundle",
    "description": "Generic CRUD Admin with Doctrine Support",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Philip Washington Sorst",
            "email": "philip@sorst.net",
            "homepage": "https://sorst.net"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "dontdrinkandroot/common": "^0.3",
        "knplabs/knp-paginator-bundle": "^6.10",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/form": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/twig-bundle": "^7.4"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/orm": "^3.6",
        "dontdrinkandroot/symfony-version-enforcer": "^0.1.0",
        "liip/test-fixtures-bundle": "^3.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/translation": "7.4.*",
        "pb30/phpstan-composer-analysis": "^1.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Dontdrinkandroot\\CrudAdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dontdrinkandroot\\CrudAdminBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dontdrinkandroot/symfony-version-enforcer": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*",
            "allow-contrib": true
        },
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
